</head>
<body>

    <!-- Accessibility Control Bar -->
    <aside class="accessibility-bar" aria-label="Accessibility Controls">
        <div class="container accessibility-container">
            <span class="accessibility-title"><i class="fa-solid fa-universal-access"></i> <span data-i18n="accessibility">Accessibility</span>:</span>
            <div class="accessibility-buttons">
                <label class="language-picker" for="language-select">
                    <i class="fa-solid fa-language" aria-hidden="true"></i>
                    <span class="sr-only">Choose language</span>
                    <select id="language-select" aria-label="Choose language">
                        <option value="en">English</option>
                        <option value="af">Afrikaans</option>
                        <option value="zu">isiZulu</option>
                    </select>
                </label>
                <div id="google_translate_element" class="google-translate-hidden" aria-hidden="true"></div>
                <button id="btn-decrease-font" class="acc-btn" title="Decrease Text Size">A -</button>
                <button id="btn-reset-font" class="acc-btn" title="Reset Text Size">Normal</button>
                <button id="btn-increase-font" class="acc-btn" title="Increase Text Size">A +</button>
                <button id="btn-toggle-theme" class="acc-btn" title="Toggle High Contrast Dark Mode"><i class="fa-solid fa-moon"></i> <span data-i18n="highContrast">High Contrast</span></button>
                <button id="btn-read-aloud" class="acc-btn highlight-acc" title="Read Page Aloud"><i class="fa-solid fa-volume-high"></i> <span data-i18n="listenToPage">Listen to Page</span></button>
            </div>
        </div>
    </aside>

    <!-- Main Header -->
    <header class="main-header">
        <div class="container header-container">
            <a href="#home" class="logo" onclick="navigateTo('home')">
                 <img src="logo.png" alt="SilverAssist Logo">
        
            </a>

            <!-- Mobile Menu Toggle (visible on small screens only) -->
            <button class="acc-btn mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Toggle menu">☰ Menu</button>

            <!-- Navigation Links -->
            <nav class="nav-menu" id="nav-menu">
                <a href="#home" class="nav-link active" onclick="navigateTo('home')"><i class="fa-solid fa-house"></i> <span data-i18n="home">Home</span></a>
                <a href="#aboutus" class="nav-link" onclick="navigateTo('aboutus')"><i class="fa-solid fa-laptop"></i> <span data-i18n="aboutContact">About Us and Contact</span></a>
        
                 <a href="#about" class="nav-link" onclick="navigateTo('about')"><i class="fa-solid fa-book-open"></i> <span data-i18n="informationEthics">Information Ethics</span></a>
                     <a href="#safety" class="nav-link" onclick="navigateTo('safety')"><i class="fa-solid fa-user-shield"></i> <span data-i18n="startLearning">Start learning</span></a>
                     <a href="#linkchecker" class="nav-link" onclick="navigateTo('linkchecker')"><i class="fa-solid fa-robot"></i> <span data-i18n="scamChecker">Scam Checker</span></a>
            
            </nav>

            <!-- Search Bar -->
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="global-search" placeholder="Search safety topics..." aria-label="Search safety topics" data-i18n-placeholder="searchTopics">
            </div>
        </div>
    </header>

    <!-- Main Content Sections -->
    <main id="main-content" class="container">

        <!-- 1. HOME SECTION -->
        <section id="page-home" class="page-section active-page">
            <div class="hero-card">
