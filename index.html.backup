                <button class="btn btn-primary" onclick="navigateTo('facebook')">Learn Facebook</button>
            </div>
            <div class="card">
                <h2><i class="fa-solid fa-clipboard-question"></i> Quiz 4: Useful Apps for Everyday Life</h2>
